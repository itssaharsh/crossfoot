# keys never live in this repository
.env
.env.*
# Python
__pycache__/
.venv/
# downloaded scans and published files; fetched again by `crossfoot fetch`
/data/
# run caches; first-read crops are large and can be re-made (finding crops live under runs/<run>/<county>/crops/)
/runs/*/cache/
/runs/*/crops/
*.sqlite-journal
# a page build in progress; it replaces site/data/ only when it succeeds
/site/data.new/
# deploy metadata
.vercel

# a run folder keeps its results; a new ledger is not committed (the ones documents quote from stay tracked)
/runs/*/ledger.sqlite
